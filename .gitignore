# Python caches
__pycache__/
*.pyc
*.pyo

# Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments (including environments/tsicl/.venv/)
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

# Test artifacts
.pytest_cache/

# Local data scratch folders (not the tracked data/ or results/ trees)
data_local/
scratch/
*.tmp

# Local TS-ICL checkpoint/cache directories a user might download
.tsicl_cache/
checkpoints/
*.ckpt
*.pt

# OS cruft
.DS_Store

# LaTeX auxiliaries / Tectonic build artifacts (Tectonic's default output
# filename, main.pdf, is never the tracked PDF name in manuscript/ -- those
# are copied to their final, tracked filenames after compiling)
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
tectonic.log
manuscript/*/main.pdf

# ruff cache
.ruff_cache/
