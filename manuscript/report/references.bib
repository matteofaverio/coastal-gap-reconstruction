@misc{multiobs_currents,
  author       = {{Copernicus Marine Service}},
  title        = {{Global Total (COPERNICUS-GLOBCURRENT), Ekman and Geostrophic Currents
                   at the Surface and 15m}},
  year         = {2022},
  doi          = {10.48670/mds-00327},
  note         = {%
    Product ID: \texttt{MULTIOBS\_GLO\_PHY\_MYNRT\_015\_003}.
    Multiyear dataset: \texttt{cmems\_obs-mob\_glo\_phy-cur\_my\_0.25deg\_P1D-m} (version 202411).
    MY coverage: 1993-01-01 to 2026-03-31; NRT appended for 2026-04-01 to 2026-05-31.
    Variables used: geostrophic (\texttt{ugos}/\texttt{vgos}) and Ekman (\texttt{ue}/\texttt{ve})
    components at 1/4° ($\approx$28 km at 30°S). Total current (\texttt{uo}/\texttt{vo}) is NaN
    at the Tongoy coastal cell due to coastal masking.
    \url{https://data.marine.copernicus.eu/product/MULTIOBS_GLO_PHY_MYNRT_015_003}.%
  },
}

